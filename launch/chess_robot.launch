<launch>
  <!-- ===========================================================
       国际象棋机械臂对弈系统 —— 主启动文件（终端输入版）

       启动顺序:
         1. motion_planner  →  机械臂激活并移动到待机位置
         2. board_detector  →  等待机械臂归位后，启动 ArUco 棋盘定位
         3. main.py（手动） →  终端输入对弈

       AI 协调器（main.py）需要在单独的终端手动运行，
       因为需要交互式 stdin 输入。

       用法:
         1. roslaunch chess_robot_arm chess_robot.launch   # 启动本文件
         2. rosrun chess_robot_arm main.py                  # 另开终端运行 AI

       注意: 不再使用 YOLO 棋子识别，棋盘状态由用户在终端手动输入。
       =========================================================== -->

  <!-- ====== 机械臂名称 ====== -->
  <arg name="robot_name" default="my_gen3_lite" />

  <!-- ====== 相机参数 ====== -->
  <arg name="camera_width"  default="1280" />
  <arg name="camera_height" default="720" />
  <arg name="camera_fps"    default="30" />

  <!-- ====== ArUco 标签参数 ====== -->
  <arg name="aruco_marker_size"     default="0.05" />
  <arg name="aruco_dict_name"       default="DICT_6X6_250" />
  <arg name="aruco_top_left_id"     default="0" />
  <arg name="aruco_top_right_id"    default="1" />
  <arg name="aruco_bottom_left_id"  default="2" />
  <arg name="aruco_bottom_right_id" default="3" />

  <!-- ====== 夹爪姿态（欧拉角，度） ====== -->
  <arg name="gripper_orientation_deg" default="[0.0, 180.0, 45.0]" />

  <!-- ==========================================
       Node 1: ArUco 棋盘角点检测
       发布话题:
         /chessboard_corners_3d  —— 棋盘四角 3D 坐标（相机系）
         /chessboard_corners_2d  —— 棋盘四角 2D 像素坐标
         /camera/color/image_raw —— 原始彩色图像
       ========================================== -->
  <node name="chessboard_detector" pkg="chess_robot_arm"
        type="board_detector.py" output="screen">
    <param name="marker_size"           value="$(arg aruco_marker_size)" />
    <param name="aruco_dictionary_name" value="$(arg aruco_dict_name)" />
    <param name="top_left_id"           value="$(arg aruco_top_left_id)" />
    <param name="top_right_id"          value="$(arg aruco_top_right_id)" />
    <param name="bottom_left_id"        value="$(arg aruco_bottom_left_id)" />
    <param name="bottom_right_id"       value="$(arg aruco_bottom_right_id)" />
    <param name="color_width"           value="$(arg camera_width)" />
    <param name="color_height"          value="$(arg camera_height)" />
    <param name="fps"                   value="$(arg camera_fps)" />
    <param name="show_cv_window"        value="true" />
    <param name="camera_frame_id"       value="camera_color_optical_frame" />
    <param name="wait_for_arm_home"     value="true" />
  </node>

  <!-- ==========================================
       Node 2: 运动规划器（Kinova 机械臂控制）
       订阅话题:
         /kinova_pick_place/goal_in_camera —— 移动目标
       发布话题:
         /my_gen3_lite/arm_status           —— 机械臂状态
       ========================================== -->
  <node name="motion_planner" pkg="chess_robot_arm"
        type="motion_planner.py" output="screen">
    <param name="robot_name"               value="$(arg robot_name)" />
    <param name="gripper_orientation_deg"  value="$(arg gripper_orientation_deg)" />
    <param name="pre_action_z_lift"        value="0.05" />
    <param name="pick_z_offset"            value="0.005" />
    <param name="place_z_offset"           value="0.01" />
    <param name="gripper_open"             value="0.7" />
    <param name="gripper_close"            value="0.25" />
    <param name="use_base_frame_coords"    value="true" />
  </node>

  <!-- ==========================================
       Node 3（手动启动）: AI 协调器
       在另一个终端中运行:
         rosrun chess_robot_arm main.py \
           _stockfish_path:=/usr/games/stockfish \
           _think_time:=3.0 \
           _board_z:=0.38
       ========================================== -->

</launch>
